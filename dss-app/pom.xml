<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dss</groupId>
        <artifactId>dss</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>dss-app</artifactId>
    <name>dss-app</name>
    <description>启动模块：聚合全部业务模块，放启动类和 application*.yml</description>

    <dependencies>
        <dependency>
            <groupId>com.dss</groupId>
            <artifactId>dss-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dss</groupId>
            <artifactId>dss-file</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dss</groupId>
            <artifactId>dss-user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dss</groupId>
            <artifactId>dss-shop</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dss</groupId>
            <artifactId>dss-product</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dss</groupId>
            <artifactId>dss-order</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dss</groupId>
            <artifactId>dss-favorite</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dss</groupId>
            <artifactId>dss-search</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 只有启动模块打可执行 jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
