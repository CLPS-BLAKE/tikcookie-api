<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.dss</groupId>
    <artifactId>dss</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>dss</name>
    <description>抖省省仿制练手项目（模块化单体）</description>

    <modules>
        <module>dss-common</module>
        <module>dss-file</module>
        <module>dss-user</module>
        <module>dss-shop</module>
        <module>dss-product</module>
        <module>dss-order</module>
        <module>dss-favorite</module>
        <module>dss-search</module>
        <module>dss-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 2.8.x 跟进 Spring Boot 3.5；3.x 是给 Spring Boot 4 的 -->
        <springdoc.version>2.8.17</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.dss</groupId>
                <artifactId>dss-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dss</groupId>
                <artifactId>dss-file</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dss</groupId>
                <artifactId>dss-user</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dss</groupId>
                <artifactId>dss-shop</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dss</groupId>
                <artifactId>dss-product</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dss</groupId>
                <artifactId>dss-order</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dss</groupId>
                <artifactId>dss-favorite</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dss</groupId>
                <artifactId>dss-search</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 显式声明注解处理器：用 JDK 23 及以上的 javac 编译时，不再自动发现 classpath 上的 Lombok -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
