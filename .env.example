# 单机 Linux 可信网络演示。后端与中间件共用本仓库这一份环境配置示例。
# 复制为 .env 后运行 chmod 600 .env。真实凭据不提交，也不放进前端 VITE_*。
# 中间件：docker compose --env-file .env -f deploy/compose/middleware.yml up -d --build
# 后端：在 tikcookie-api 中用 JDK 21 运行，命令见 docs/DEPLOYMENT.md。
# Spring 从工作目录读取 .env。进程管理器也须把工作目录设为 tikcookie-api，
# 并通过 EnvironmentFile 等方式传入 SERVER_ADDRESS 和 JAVA_TOOL_OPTIONS。
# 每项只写 KEY=value，值不加引号，不写 export 或 shell 展开。
# 用 openssl rand -hex 32 分别生成独立口令，不要共用示例值。
# 两个 MySQL 用户密码必须为 32–128 位十六进制，其余本地口令也建议使用此格式。

# 仅新环境首次启动：审查 dss-init.sql，再明确填入 CREATE_NEW_DSS。
# 留空会阻止 Compose 启动。仅空 MySQL 数据卷执行建表及账号初始化。
# 不用于旧库升级或重置，不复用旧 ECS 数据卷，不执行 compose down -v。
DSS_NEW_DATABASE_CONFIRM=
DSS_MYSQL_ROOT_PASSWORD=<generate-independent-hex-secret>
DSS_LOGSTASH_MYSQL_PASSWORD=<generate-independent-hex-secret>

# 后端在宿主机运行，不是第六个容器。只通过 Nginx 对外提供演示入口。
DSS_PROFILE=prod
DSS_SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Shanghai
DSS_SWAGGER_ENABLED=false

# mysql-init.sh 使用固定库名 dss 和账号 dss_app、dss_logstash，不要随意改名。
# root 仅用于管理；应用账号只做增删改查，Logstash 只读 products 和 shops。
DSS_MYSQL_HOST=127.0.0.1
DSS_MYSQL_PORT=3306
DSS_MYSQL_DATABASE=dss
DSS_MYSQL_USERNAME=dss_app
DSS_MYSQL_PASSWORD=<generate-independent-hex-secret>

DSS_REDIS_HOST=127.0.0.1
DSS_REDIS_PORT=6379
DSS_REDIS_PASSWORD=<generate-independent-hex-secret>

# 不使用 guest；Compose 与后端共用以下 RabbitMQ 用户和 vhost。
DSS_RABBIT_HOST=127.0.0.1
DSS_RABBIT_PORT=5672
DSS_RABBIT_VHOST=/dss
DSS_RABBIT_USERNAME=dss_app
DSS_RABBIT_PASSWORD=<generate-independent-hex-secret>

# 演示 ES 使用带认证的本机 HTTP 和 elastic 账号，不是生产 TLS/权限方案。
# 9200 不开放公网。Logstash 在容器内部使用 es 服务名，不用下面的回环地址。
DSS_ES_URIS=http://127.0.0.1:9200
DSS_ES_USERNAME=elastic
DSS_ES_PASSWORD=<generate-independent-hex-secret>

# OSS 由你自行准备。资源创建、费用、权限和验证步骤见 docs/CONFIGURATION.md。
# Compose 不创建云资源。endpoint 使用带 oss- 地域前缀的服务地址。
# RAM 密钥只供后端使用，权限限于演示 Bucket；不能加在图片 URL 中。
DSS_OSS_ENDPOINT=https://oss-<region>.aliyuncs.com
DSS_OSS_BUCKET=<your-demo-bucket>
DSS_OSS_REGION=cn-<region>
DSS_OSS_ACCESS_KEY_ID=<your-backend-only-access-key-id>
DSS_OSS_ACCESS_KEY_SECRET=<your-backend-only-access-key-secret>
# 默认私有 Bucket，经后端同源代理读图，URL 中不含凭据。
# 代理读图接口是公开的，因此只能存可公开展示的演示图片。
# 如果明确选择 OSS 公共读取，可改为对应公共 HTTPS 域名前缀。
DSS_FILE_BASE_URL=/api/v1/images
DSS_FILE_MAX_SIZE=5MB
DSS_FILE_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# 内部口令；Nginx 会拒绝公开访问内部接口，即使带了正确口令。
DSS_INTERNAL_KEY=<generate-independent-hex-secret>
DSS_AUTH_TOKEN_TTL=P7D
DSS_ORDER_PAY_TIMEOUT_MINUTES=15
DSS_JOB_ENABLED=true
DSS_JOB_ORDER_TIMEOUT_INTERVAL=PT1M
DSS_JOB_VOUCHER_EXPIRE_INTERVAL=PT1M

# 首次只检查基础服务，不自动追加演示商品；需要抢购时再改为 true 并重启。
DSS_FLASH_ENABLED=false
DSS_FLASH_MQ_PREFIX=dss.flash
DSS_FLASH_LIFECYCLE_INTERVAL=PT1S
DSS_FLASH_REQUEST_TIMEOUT_INTERVAL=PT1S
# ES 只由 Logstash 写入，这项必须保持 false。
DSS_SEARCH_REBUILD_ON_STARTUP=false
