# TikCookie API 后端环境变量示例，对应 src/main/resources/application.yml 里的 ${DSS_…}，共 34 项。
# 用法：复制为 .env（已被 .gitignore 忽略）后填写；本地也可以在 IDEA 运行配置的"环境变量"里逐项填，
# 服务器上由受控的环境文件注入。这里只有占位符：不要填真实口令或密钥，填好的 .env 不要提交（docs/CONFIGURATION.md）。
# 每项注释依次说明：用途｜是否必填｜示例格式｜默认值和适用环境｜是否敏感。
# 标"必填"的变量没有默认值，缺一个应用就会启动失败。

# ---------- 应用端口与运行环境 ----------
# Spring profile｜选填｜dev 或 prod｜默认 dev；服务器上填 prod｜不敏感
DSS_PROFILE=dev
# 后端监听端口｜选填｜端口号｜默认 8080｜不敏感
DSS_SERVER_PORT=8080
# 是否开放 Swagger UI 和 /v3/api-docs｜选填｜true 或 false｜默认 true；外网访问由 Nginx 拦截｜不敏感
DSS_SWAGGER_ENABLED=true

# ---------- MySQL（JDBC 参数固定写在 application.yml：utf8、connectionTimeZone=Asia/Shanghai） ----------
# MySQL 地址｜必填｜主机名或 IP（ECS B 私网地址）｜无默认值｜不敏感
DSS_MYSQL_HOST=<mysql-host>
# MySQL 端口｜选填｜端口号｜默认 3306｜不敏感
DSS_MYSQL_PORT=3306
# 库名｜选填｜库名，与 dss-init.sql 一致｜默认 dss｜不敏感
DSS_MYSQL_DATABASE=dss
# 应用账号，只需 dss 库的增删改查权限，不要用建表的管理账号｜必填｜用户名｜无默认值｜不敏感
DSS_MYSQL_USERNAME=<mysql-app-user>
# 应用账号口令｜必填｜字符串｜无默认值｜敏感
DSS_MYSQL_PASSWORD=<change-me>

# ---------- Redis（只放验证码、发送间隔、错误次数和登录 token） ----------
# Redis 地址｜必填｜主机名或 IP（ECS A 私网地址）｜无默认值｜不敏感
DSS_REDIS_HOST=<redis-host>
# Redis 端口｜选填｜端口号｜默认 6379｜不敏感
DSS_REDIS_PORT=6379
# Redis 口令｜必填｜字符串｜无默认值｜敏感
DSS_REDIS_PASSWORD=<change-me>

# ---------- RabbitMQ（只用于搜索同步） ----------
# RabbitMQ 地址｜必填｜主机名或 IP（ECS A 私网地址）｜无默认值｜不敏感
DSS_RABBIT_HOST=<rabbitmq-host>
# AMQP 端口｜选填｜端口号｜默认 5672｜不敏感
DSS_RABBIT_PORT=5672
# vhost｜选填｜以 / 开头｜默认 /dss｜不敏感
DSS_RABBIT_VHOST=/dss
# vhost 内的应用账号｜必填｜用户名｜无默认值｜不敏感
DSS_RABBIT_USERNAME=<rabbitmq-app-user>
# 应用账号口令｜必填｜字符串｜无默认值｜敏感
DSS_RABBIT_PASSWORD=<change-me>

# ---------- Elasticsearch ----------
# ES 地址，只给后端用，不要提供给浏览器｜必填｜http(s)://主机:端口，多个用逗号分隔｜无默认值｜不敏感
DSS_ES_URIS=http://<es-host>:9200
# ES 账号，开启安全认证时才填｜选填｜用户名｜默认空（不认证）｜不敏感
DSS_ES_USERNAME=
# ES 口令，开启安全认证时才填｜选填｜字符串｜默认空｜敏感
DSS_ES_PASSWORD=

# ---------- OSS 图片 ----------
# OSS endpoint｜必填｜https://oss-<region>.aliyuncs.com｜无默认值｜不敏感
DSS_OSS_ENDPOINT=https://oss-<region>.aliyuncs.com
# 演示图片专用 Bucket｜必填｜Bucket 名｜无默认值｜不敏感
DSS_OSS_BUCKET=<bucket-name>
# Bucket 所在地域｜必填｜如 cn-<region>｜无默认值｜不敏感
DSS_OSS_REGION=cn-<region>
# AccessKey ID，按凭据方式填写，演示环境可用最小权限的专用 RAM 用户｜选填｜字符串｜默认空｜敏感
DSS_OSS_ACCESS_KEY_ID=
# AccessKey Secret，同上｜选填｜字符串｜默认空｜敏感
DSS_OSS_ACCESS_KEY_SECRET=
# 图片的 HTTPS 公共读取前缀，返回的 url = 它 + "/" + fileId｜必填｜https://…，末尾不带 /｜无默认值｜不敏感
DSS_FILE_BASE_URL=https://<bucket-name>.oss-<region>.aliyuncs.com
# 单张图片上限｜选填｜如 5MB｜默认 5MB｜不敏感
DSS_FILE_MAX_SIZE=5MB
# 允许的图片类型｜选填｜逗号分隔的 Content-Type｜默认 image/jpeg,image/png,image/webp｜不敏感
DSS_FILE_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# ---------- 鉴权 ----------
# 内部接口口令（请求头 X-Internal-Key）｜要用内部接口就必填｜随机长字符串｜默认空：内部接口一律返回 403｜敏感
DSS_INTERNAL_KEY=<change-me>
# 登录态有效期，每次访问续满｜选填｜ISO-8601 时长，如 P7D｜默认 P7D｜不敏感
DSS_AUTH_TOKEN_TTL=P7D

# ---------- 订单、定时任务和搜索维护 ----------
# 待支付超时分钟数：payDeadline = 下单时间 + 它｜选填｜整数｜默认 15｜不敏感
DSS_ORDER_PAY_TIMEOUT_MINUTES=15
# 订单定时任务总开关（超时取消、到期退款），单实例运行｜选填｜true 或 false｜默认 false；实现完订单任务后再打开｜不敏感
DSS_JOB_ENABLED=false
# 超时取消任务的间隔｜选填｜ISO-8601 时长｜默认 PT1M｜不敏感
DSS_JOB_ORDER_TIMEOUT_INTERVAL=PT1M
# 到期退款任务的间隔｜选填｜ISO-8601 时长｜默认 PT1M｜不敏感
DSS_JOB_VOUCHER_EXPIRE_INTERVAL=PT1M
# 启动后清空并从 MySQL 全量重建两个 ES 索引，只给部署方用｜选填｜true 或 false｜默认 false；重建完改回 false｜不敏感
DSS_SEARCH_REBUILD_ON_STARTUP=false

# 日志级别没有单独的变量：跟随 DSS_PROFILE（dev 下 com.dss 为 debug，prod 下为 info）。
# 健康检查和监控参数还没有定（见 docs/DEPLOYMENT.md 第 6 节）。
